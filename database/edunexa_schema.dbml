// Relationships
// ==========================================
Ref: campuses.institution_code > institutions.code
Ref: departments.campus_code > campuses.code
Ref: programs.department_code > departments.code
Ref: batches.program_code > programs.code
Ref: semesters.academic_year_code > academic_years.code
Ref: sections.batch_code > batches.code
Ref: sections.semester_code > semesters.code
Ref: subjects.department_code > departments.code
