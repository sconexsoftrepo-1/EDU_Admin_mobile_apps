Ref: curriculum_subjects.subject_code > subjects.code
Ref: rooms.campus_code > campuses.code
Ref: employees.campus_code > campuses.code
Ref: employees.department_code > departments.code
Ref: employees.reporting_employee_code > employees.code [delete: no action, update: no action]
Ref: teachers.employee_code - employees.code
Ref: staff_profiles.employee_code - employees.code
Ref: students.campus_code > campuses.code
Ref: students.admission_application_code - admission_applications.code [delete: no action, update: no action]
Ref: student_parents.student_code > students.code
Ref: student_parents.parent_code > parents.code
Ref: student_enrollments.student_code > students.code
Ref: student_enrollments.section_code > sections.code
Ref: subject_offerings.subject_code > subjects.code
Ref: subject_offerings.section_code > sections.code
Ref: subject_offerings.teacher_code > teachers.code
