  error_code text
  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]
}

Table certificate_download_events {
  id bigint [pk, increment]
  code varchar(100) [unique, not null]
  certificate_code varchar(100) [not null]
  user_code varchar(100) [not null]
  downloaded_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  channel text [not null, note: 'ENUM: web, parent_app, student_app, admin_app']
  document_sha256 character(64) [not null]
  request_id text [unique, not null]
  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]
}

Table certificate_signatures {
  id bigint [pk, increment]
  code varchar(100) [unique, not null]
  certificate_code varchar(100) [unique, not null]
  signing_provider text [not null]
  key_reference text [not null]
  signature_algorithm text [not null]
  signed_document_storage_key text [unique, not null]
  document_sha256 character(64) [not null]
  signed_by_employee_code varchar(100) [not null]
  signed_at timestamptz [not null]
  revoked_at timestamptz
  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]
}

Table employee_tax_documents {
  id bigint [pk, increment]
  code varchar(100) [unique, not null]
  employee_code varchar(100) [not null]
  financial_year varchar(9) [not null]
  document_type text [not null, note: 'ENUM: form_16, form_16a, other']
  revision integer [not null, default: 1]
  storage_key text [unique, not null]
  sha256 character(64) [not null]
  published_by_employee_code varchar(100) [not null]
  published_at timestamptz [not null]
  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    (employee_code, financial_year, document_type, revision) [unique]
  }
}

Table admin_mobile_preferences {
  id bigint [pk, increment]
  code varchar(100) [unique, not null]
  user_code varchar(100) [unique, not null]
  default_campus_code varchar(100)
  default_period text [not null, default: 'month', note: 'ENUM: day, week, month, all']
  alerts_enabled boolean [not null, default: false]
  report_preferences jsonb [not null, default: `'{}'`]
  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]
}

Table report_export_jobs {
  id bigint [pk, increment]
  code varchar(100) [unique, not null]
  requested_by_user_code varchar(100) [not null]
  campus_code varchar(100) [not null]
