  next_follow_up_at timestamptz
  communication_consent boolean [not null, default: false]
  consent_recorded_at timestamptz
  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]
}

Table enquiry_followups {
  id bigint [pk, increment]
  code varchar(100) [unique, not null]
  enquiry_code varchar(100) [not null]
  employee_code varchar(100) [not null]
  occurred_at timestamptz [not null]
  channel text [not null, note: 'ENUM: call, sms, email, visit, other']
  outcome text [not null]
  notes text
  next_follow_up_at timestamptz
  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]
}

Table application_guardians {
  id bigint [pk, increment]
  code varchar(100) [unique, not null]
  application_code varchar(100) [not null]
  relationship text [not null, note: 'ENUM: father, mother, guardian, other']
  first_name text [not null]
  last_name text [not null]
  phone varchar(40) [not null]
  email varchar(254)
  occupation text
  address jsonb
  is_primary boolean [not null, default: false]
  parent_code varchar(100)
  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    application_code [unique, name: 'uq_application_primary_guardian', note: 'WHERE is_primary']
  }
}

Table application_qualifications {
  id bigint [pk, increment]
  code varchar(100) [unique, not null]
  application_code varchar(100) [not null]
  qualification text [not null]
  institution text [not null]
  board_university text
  passing_year integer
  registration_number varchar(100)
  score decimal(8,2)
  score_scale text [note: 'ENUM: percentage, cgpa_10, gpa_4, other']
  maximum_score decimal(8,2)
  result_status text [not null, note: 'ENUM: passed, awaiting, failed']
  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]
}

Table document_types {
  id bigint [pk, increment]
  code varchar(100) [unique, not null]
  name text [not null]
  description text
  accepted_mime_types text[] [not null, default: `ARRAY['application/pdf'::text, 'image/jpeg'::text, 'image/png'::text]`]
  maximum_file_bytes bigint [not null, default: 10485760]
  expiry_required boolean [not null, default: false]
  original_sighting_required boolean [not null, default: false]
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]
}

Table program_document_requirements {
  id bigint [pk, increment]
  code varchar(100) [unique, not null]
  program_code varchar(100) [not null]
  academic_year_code varchar(100) [not null]
  document_type_code varchar(100) [not null]
  admission_category text [not null, default: 'all', note: 'ENUM: all, regular, lateral_entry, transfer, readmission']
  required_stage text [not null, note: 'ENUM: submission, offer, enrollment']
  is_required boolean [not null, default: true]
  waiver_allowed boolean [not null, default: false]
  instructions text
  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    (program_code, academic_year_code, document_type_code, admission_category, required_stage) [unique]
  }
}

Table admission_documents {
  id bigint [pk, increment]
  code varchar(100) [unique, not null]
  application_code varchar(100) [not null]
  document_type_code varchar(100) [not null]
  revision integer [not null, default: 1]
  is_current boolean [not null, default: true]
  storage_key text [unique]
  original_filename text
  mime_type text
  size_bytes bigint
  sha256 character(64)
  issued_on date
  expires_on date
  uploaded_by_user_code varchar(100)
  received_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  received_by_employee_code varchar(100)
  status text [not null, note: 'ENUM: received, pending_verification, verified, rejected, waived']
  original_sighted boolean [not null, default: false]
  original_sighted_by_code varchar(100)
  original_sighted_at timestamptz
  reviewed_by_employee_code varchar(100)
  reviewed_at timestamptz
  review_notes text
  waiver_reason text
  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    (application_code, document_type_code, revision) [unique]
    (application_code, document_type_code) [unique, name: 'uq_current_admission_document', note: 'WHERE is_current']
  }
}

