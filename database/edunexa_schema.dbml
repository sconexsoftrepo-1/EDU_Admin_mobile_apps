  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]
}

Table employees {
  id bigint [pk, increment]
  code varchar(100) [unique, not null]
  campus_code varchar(100) [not null]
  department_code varchar(100) [not null]
  first_name text [not null]
  last_name text [not null]
  employee_type text [not null, note: 'ENUM: teacher, staff']
  designation text [not null]
  email varchar(254) [not null]
  phone varchar(40) [not null]
  date_of_birth date
  gender text [note: 'ENUM: female, male, other, prefer_not_to_say']
  join_date date [not null]
  employment_type text [not null, note: 'ENUM: permanent, contract, part_time']
  address text
  city text
  state text
  postal_code varchar(100)
  emergency_contact_name text
  emergency_contact_phone varchar(40)
  status text [not null, note: 'ENUM: active, on_leave, left']
  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  personal_email varchar(254)
  middle_name text
  contract_end_date date
  confirmation_date date
  exit_date date
  reporting_employee_code varchar(100)
  address_details jsonb
  qualifications jsonb
  appointment_document_reference text
}

Table teachers {
  id bigint [pk, increment]
  code varchar(100) [unique, not null]
  employee_code varchar(100) [unique, not null]
  qualification text [not null]
  specialization text
  experience_years decimal(12,2)
  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]
}

Table staff_profiles {
  id bigint [pk, increment]
  code varchar(100) [unique, not null]
  employee_code varchar(100) [unique, not null]
  responsibility text [not null]
  shift text
  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]
}

Table students {
  id bigint [pk, increment]
  code varchar(100) [unique, not null]
  campus_code varchar(100) [not null]
  admission_number varchar(100) [unique, not null]
  first_name text [not null]
  last_name text [not null]
  date_of_birth date [not null]
  gender text [not null, note: 'ENUM: female, male, other, prefer_not_to_say']
  email varchar(254)
  phone varchar(40)
  admission_date date [not null]
  address text [not null]
  city text [not null]
  state text [not null]
  postal_code varchar(100) [not null]
  country text [not null]
  blood_group text [note: 'ENUM: A+, A-, B+, B-, AB+, AB-, O+, O-, unknown']
  nationality text
  previous_institution text
  previous_qualification text
  previous_score decimal(12,2)
  emergency_contact_name text [not null]
  emergency_contact_phone varchar(40) [not null]
  status text [not null, note: 'ENUM: active, graduated, withdrawn, suspended, relieved']
  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  middle_name text
  preferred_name text
  permanent_address jsonb
  current_address_details jsonb
  university_registration_number varchar(100)
  admission_category text
  previous_education jsonb
  profile_photo_storage_key text
  relieved_on date
  relieving_reason text
  admission_application_code varchar(100) [unique]
}

Table parents {
  id bigint [pk, increment]
  code varchar(100) [unique, not null]
  first_name text [not null]
  last_name text [not null]
  email varchar(254)
  phone varchar(40) [not null]
  alternate_phone varchar(40)
  occupation text
  address text
  city text
  state text
  postal_code varchar(100)
  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  work_contact jsonb
