Ref: student_subjects.offering_code > subject_offerings.code
Ref: timetable_slots.offering_code > subject_offerings.code
Ref: timetable_slots.room_code > rooms.code
Ref: attendance_sessions.offering_code > subject_offerings.code
Ref: attendance_sessions.recorded_by_code > teachers.code
Ref: student_attendance.session_code > attendance_sessions.code
Ref: student_attendance.student_code > students.code
Ref: employee_attendance.employee_code > employees.code
Ref: leave_requests.employee_code > employees.code
Ref: leave_requests.leave_type_code > leave_types.code
Ref: leave_requests.approved_by_code > employees.code
Ref: student_leave_requests.student_code > students.code
Ref: student_leave_requests.approved_by_code > employees.code
Ref: admission_applications.program_code > programs.code
Ref: admission_applications.academic_year_code > academic_years.code
Ref: admission_applications.student_code > students.code
Ref: admission_applications.enquiry_code > admission_enquiries.code [delete: no action, update: no action]
