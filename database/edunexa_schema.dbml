  address_details jsonb
}

Table student_parents {
  id bigint [pk, increment]
  code varchar(100) [unique, not null]
  student_code varchar(100) [not null]
  parent_code varchar(100) [not null]
  relationship text [not null, note: 'ENUM: father, mother, guardian, other']
  is_primary boolean [not null]
  can_pickup boolean [not null]
  receives_notifications boolean [not null]
  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    (student_code, parent_code) [unique]
    student_code [unique, name: 'uq_primary_parent', note: 'WHERE is_primary']
  }
}

Table student_enrollments {
  id bigint [pk, increment]
  code varchar(100) [unique, not null]
  student_code varchar(100) [not null]
