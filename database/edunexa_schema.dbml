Ref: admission_applications.source_code > admission_sources.code [delete: no action, update: no action]
Ref: admission_applications.assigned_employee_code > employees.code [delete: no action, update: no action]
Ref: admission_applications.submitted_by_user_code > users.code [delete: no action, update: no action]
Ref: fee_heads.external_party_code > external_parties.code [delete: no action, update: no action]
Ref: fee_structures.program_code > programs.code
Ref: fee_structures.academic_year_code > academic_years.code
Ref: fee_structures.fee_head_code > fee_heads.code
Ref: student_fee_charges.student_code > students.code
Ref: student_fee_charges.fee_structure_code > fee_structures.code
Ref: payments.student_code > students.code
Ref: payment_allocations.payment_code > payments.code
Ref: payment_allocations.charge_code > student_fee_charges.code
Ref: receipts.payment_code - payments.code
Ref: refunds.payment_code > payments.code
Ref: scholarships.academic_year_code > academic_years.code
Ref: student_scholarships.student_code > students.code
Ref: student_scholarships.scholarship_code > scholarships.code
Ref: fee_adjustments.charge_code > student_fee_charges.code
Ref: fee_adjustments.approved_by_code > employees.code
Ref: expenses.campus_code > campuses.code
Ref: expenses.vendor_code > vendors.code
Ref: expenses.approved_by_code > employees.code
Ref: employee_salary_components.employee_code > employees.code
