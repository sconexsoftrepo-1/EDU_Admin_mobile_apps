  consent_at timestamptz
  submitted_at timestamptz
  assigned_employee_code varchar(100)
  submitted_by_user_code varchar(100)

  indexes {
    student_code [unique, name: 'uq_application_student', note: 'WHERE (student_code IS NOT NULL)']
  }
}

Table fee_heads {
  id bigint [pk, increment]
  code varchar(100) [unique, not null]
  name text [not null]
  description text
  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  collection_ownership text [not null, default: 'internal', note: 'ENUM: internal, external']
  external_party_code varchar(100)
  scholarship_eligible boolean [not null, default: true]
}

Table fee_structures {
  id bigint [pk, increment]
  code varchar(100) [unique, not null]
  program_code varchar(100) [not null]
  academic_year_code varchar(100) [not null]
  fee_head_code varchar(100) [not null]
  semester_number integer [not null]
  amount decimal(14,2) [not null]
  due_date date [not null]
  currency varchar(100) [not null]
  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  installment_number integer [not null, default: 1]
  billing_frequency text [not null, default: 'semester', note: 'ENUM: one_time, annual, semester, term, monthly, per_use']
  approval_reference text

  indexes {
    (program_code, academic_year_code, fee_head_code, semester_number, installment_number) [unique]
  }
}

Table student_fee_charges {
  id bigint [pk, increment]
  code varchar(100) [unique, not null]
