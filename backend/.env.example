# Generate a secret: python -c "import secrets; print(secrets.token_urlsafe(64))"
EDUNEXA_JWT_SECRET=replace-with-a-random-secret-of-at-least-48-characters
EDUNEXA_DATA_DIR=var
# postgres = Supabase/PostgreSQL via EDUNEXA_DB_*; local-json = offline development in EDUNEXA_DATA_DIR
EDUNEXA_STORAGE_BACKEND=postgres
EDUNEXA_ACCESS_MINUTES=10
EDUNEXA_REFRESH_DAYS=7
EDUNEXA_CORS_ORIGINS=["http://localhost:3000","http://localhost:3012"]
# PostgreSQL (Supabase: Project Settings > Database > Connection parameters). Quote the password
# with single quotes if it contains $ or #.
EDUNEXA_DB_HOST=db.your-project-ref.supabase.co
EDUNEXA_DB_PORT=5432
EDUNEXA_DB_NAME=postgres
EDUNEXA_DB_USER=postgres
EDUNEXA_DB_PASSWORD='replace-with-the-database-password'
EDUNEXA_DB_SSLMODE=require
