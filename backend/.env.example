# Generate a secret: python -c "import secrets; print(secrets.token_urlsafe(64))"
EDUNEXA_JWT_SECRET=replace-with-a-random-secret-of-at-least-48-characters
EDUNEXA_DATA_DIR=var
# sqlserver = Microsoft SQL Server; local-json = offline development only.
EDUNEXA_STORAGE_BACKEND=sqlserver
EDUNEXA_ACCESS_MINUTES=10
EDUNEXA_REFRESH_DAYS=7
EDUNEXA_CORS_ORIGINS=["http://localhost:3000","http://localhost:3012"]
EDUNEXA_MSSQL_HOST=185.193.19.156
EDUNEXA_MSSQL_PORT=1433
EDUNEXA_MSSQL_NAME=edu-admin-portal
EDUNEXA_MSSQL_USER=edu-admin-portal
EDUNEXA_MSSQL_PASSWORD='set-this-in-your-local-env-or-hosting-secrets'
EDUNEXA_MSSQL_DB_SCHEMA=dbo
EDUNEXA_MSSQL_ENCRYPTION=require
EDUNEXA_PUBLIC_API_URL=http://185.193.19.156:8010

# --- Vercel deployment (see README, "Deploying to Vercel") --------------------------------------
# Set EDUNEXA_STORAGE_BACKEND=sqlserver and EDUNEXA_MSSQL_* in Vercel environment variables.
# Local .env files and migration backups are never deployed.
# Files: private Supabase Storage bucket (create it with tools/setup_file_storage.py).
# EDUNEXA_FILE_STORAGE=supabase
# EDUNEXA_SUPABASE_URL=https://your-project-ref.supabase.co
# EDUNEXA_SUPABASE_SERVICE_ROLE_KEY='service-role-key-from-supabase-settings'
# EDUNEXA_SUPABASE_BUCKET=edunexa-private
# Certificate signing key (python tools/generate_signing_key.py); keep it stable.
# EDUNEXA_CERTIFICATE_SIGNING_KEY=
# EDUNEXA_CORS_ORIGINS=["https://your-dashboard.vercel.app"]
# EDUNEXA_PUBLIC_API_URL=https://your-backend.vercel.app
# EDUNEXA_PUBLIC_PORTAL_URL=https://your-dashboard.vercel.app
