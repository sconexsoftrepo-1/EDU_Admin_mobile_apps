{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::edu-admin-portal-file/Admin_Uploads/*"
    },
    {
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::edu-admin-portal-file",
      "Condition": {"StringLike": {"s3:prefix": ["Admin_Uploads", "Admin_Uploads/*"]}}
    }
  ]
}
